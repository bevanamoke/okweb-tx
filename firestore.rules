rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isMsgAuthor(authorId) {
      return request.auth != null && request.auth.uid == authorId;
    }

    function isAdminOrEditor() {
       let role = getUserData().role;
       return role == 'admin' || role == 'editor';
    }

    match /posts/{postId} {
      // Public can read published posts
      allow read: if resource.data.status == 'published';
      // Staff and Authors can read all (for dashboard)
      // Note: "list" rule might be tricky if not filtered, but we filter in query.
      allow read: if request.auth != null; 

      allow create: if request.auth != null;
      
      allow update, delete: if request.auth != null && 
                            (isAdminOrEditor() || resource.data.authorId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
